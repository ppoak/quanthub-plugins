# Copy only the settings needed by the target project.
DATA=data
# Business date used by dated collectors when --date is omitted.
DATABASE_MAINTENANCE_TIMEZONE=Asia/Shanghai
# Recipient for Xueqiu token-invalid alerts.
DATABASE_MAINTENANCE_EMAIL_TO=
SENDER=
EMAIL_PASSWORD=
SMTP_SERVER=
SMTP_PORT=465
SMTP_USE_SSL=1
RICEQUANT_USER=
RICEQUANT_PASSWORD=
CHROME_DRIVER_PATH=
DOWNLOAD_PATH=downloads/ricequant
DATASET_PATH=data
RICEQUANT_HEADLESS=0

EASTMONEY_DATA_ROOT=
EASTMONEY_MONI_UT_TOKEN=
EASTMONEY_MONI_CT_TOKEN=
EASTMONEY_MONI_PROXY=

XUEQIU_DATA_ROOT=
XUEQIU_PROXY=
# One record per account: phone,qr_email,http_proxy_url,token
# Leave the proxy URL blank to use XUEQIU_PROXY or connect directly or the token blank for QR login.
# XUEQIU_ACCOUNT_0650='13800000650,account@example.com,http://127.0.0.1:18081,token'
# Enable SMTP and IMAP on the sender mailbox before use.
XUEQIU_IMAP_SERVER=imap.qq.com
XUEQIU_IMAP_PORT=993

XUEQIU_RELOGIN_TIMEOUT=600
XUEQIU_RELOGIN_VERIFY_TIMEOUT=20

HUGGINGFACE_TOKEN=
HUGGINGFACE_BUCKET_ID=
HUGGINGFACE_BACKUP_DATA_ROOT=
HUGGINGFACE_BACKUP_QUOTES_MIN_START_DATE=2015-01-01

HUGGINGFACE_BACKUP_MAX_RETRIES=5
HUGGINGFACE_BACKUP_RETRY_SLEEP_SECONDS=60
