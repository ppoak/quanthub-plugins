EASTMONEY_SCHEDULE_TIME=22:00
XUEQIU_DATA_ROOT=
XUEQIU_PROXY=
# One record per account: phone,qr_email,clash_node_index,token
# Leave the node blank for the default route or the token blank for QR login.
# XUEQIU_ACCOUNT_0650='13800000650,account@example.com,2,token'
# XUEQIU_CLASH_CONTROLLER=http://127.0.0.1:9090
# XUEQIU_CLASH_SECRET=<controller-secret>
# XUEQIU_CLASH_GROUP=GLOBAL
# Enable SMTP and IMAP on the sender mailbox before use.
XUEQIU_IMAP_SERVER=imap.qq.com
XUEQIU_IMAP_PORT=993
XUEQIU_RELOGIN_SCHEDULE_TIME=22:00
XUEQIU_RELOGIN_SCHEDULE_DAYS=all
XUEQIU_RELOGIN_TIMEOUT=600
XUEQIU_RELOGIN_VERIFY_TIMEOUT=20
XUEQIU_CUBE_REBALANCE_SCHEDULE_TIME=15:30
XUEQIU_SOCIAL_COUNT_SCHEDULE_TIME=22:30
XUEQIU_HOT_RANK_SCHEDULE_TIME=23:00
XUEQIU_STATUS_SCHEDULE_TIME=01:30
HUGGINGFACE_TOKEN=
HUGGINGFACE_BUCKET_ID=
