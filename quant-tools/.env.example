# All relative paths resolve from the target project, not the plugin directory.
DATA=data
REPORT_DOWNLOAD_DIR=references/report-download

# Database scheduler.
DATABASE_MAINTENANCE_ENABLED_JOBS=all
DATABASE_MAINTENANCE_RUN_ON_START=0
DATABASE_MAINTENANCE_NOTIFY=0
DATABASE_MAINTENANCE_TIMEZONE=Asia/Shanghai
DATABASE_MAINTENANCE_MISFIRE_GRACE_SECONDS=21600
DATABASE_MAINTENANCE_CALENDAR_RETRY_SECONDS=60
DATABASE_MAINTENANCE_EMAIL_TO=
DATABASE_MAINTENANCE_UPSTREAM_JOB=ricequant
DATABASE_MAINTENANCE_UPSTREAM_READY_FILE=.tmp/database-maintenance/upstream_ready.json

# Optional email notifications.
SENDER=
EMAIL_PASSWORD=
SMTP_SERVER=
SMTP_PORT=465
SMTP_USE_SSL=1

# RiceQuant local browser download and import.
RICEQUANT_USER=
RICEQUANT_PASSWORD=
CHROME_DRIVER_PATH=
DOWNLOAD_PATH=downloads/ricequant
DATASET_PATH=data
RICEQUANT_HEADLESS=0
RICEQUANT_SCHEDULE_TIME=19:30

# EastMoney and Xueqiu use DATA unless their own data root is set.
EASTMONEY_DATA_ROOT=
EASTMONEY_MONI_UT_TOKEN=
EASTMONEY_MONI_CT_TOKEN=
EASTMONEY_MONI_PROXY=
EASTMONEY_INTRADAY_CHANGES_SCHEDULE_TIME=15:05
EASTMONEY_SCHEDULE_TIME=22:00
XUEQIU_DATA_ROOT=
XUEQIU_TOKENS=
XUEQIU_PROXY=
XUEQIU_CUBE_REBALANCE_SCHEDULE_TIME=15:30
XUEQIU_SOCIAL_COUNT_SCHEDULE_TIME=22:30
XUEQIU_HOT_RANK_SCHEDULE_TIME=23:00
XUEQIU_STATUS_SCHEDULE_TIME=01:30

# Hugging Face backups.
HUGGINGFACE_TOKEN=
HUGGINGFACE_BUCKET_ID=
HUGGINGFACE_BACKUP_DATA_ROOT=
HUGGINGFACE_BACKUP_QUOTES_MIN_START_DATE=2015-01-01
HUGGINGFACE_BACKUP_SCHEDULE_TIME=04:00
HUGGINGFACE_BACKUP_MAX_RETRIES=5
HUGGINGFACE_BACKUP_RETRY_SLEEP_SECONDS=60

# Report download credentials; an authorized PDF URL can also be supplied.
FXBG_USER_ID=
FXBG_USER_TOKEN=
